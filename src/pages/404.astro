---
import BaseLayout from "../layouts/BaseLayout.astro";

const pageTitle = "404 - Page Not Found | Tim Jedrek";
const pageDescription =
  "Sorry, the page you're looking for couldn't be found. Explore Tim Jedrek's blog, services, and digital marketing insights.";
const keywords =
  "404 error, page not found, Tim Jedrek, digital marketing, aviation marketing";
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  keywords={keywords}
  includeSidebar={false}
>
  <div class="text-center">
    <h1 class="text-9xl font-bold mb-4">🏝</h1>
    <h2 class="text-9xl font-bold mb-2">404</h2>
    <h3 class="text-2xl mb-4">Page Not Found</h3>
    <p class="text-lg text-gray-600 mb-6">
      The page you're looking for couldn't be found. Perhaps you're looking for
      one of these popular pages:
    </p>

    <div class="space-y-4 mb-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 max-w-md mx-auto">
        <a href="/" class="btn btn-primary">Home</a>
        <a href="/blog" class="btn btn-outline">Blog</a>
        <a href="/blog/tag/clients" class="btn btn-outline">Past Work</a>
        <a href="https://forms.timjedrek.com/contact" class="btn btn-outline"
          >Contact</a
        >
      </div>
    </div>

    <p class="text-gray-500 mb-6">
      Or go back to the <a href="/" class="text-blue-600 hover:underline"
        >homepage</a
      > to start over.
    </p>

    <a class="btn btn-accent mt-4" href="/">Take Me Home</a>
  </div>
</BaseLayout>
