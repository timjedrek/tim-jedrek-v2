---
import BaseLayout from "../layouts/BaseLayout.astro";

const pageTitle = "500 - Server Error | Tim Jedrek";
const pageDescription =
  "Something went wrong on our end. We're working to fix the issue. Please try again later.";
const keywords =
  "500 error, server error, Tim Jedrek, digital marketing, aviation marketing";
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  keywords={keywords}
  includeSidebar={false}
>
  <div class="text-center">
    <h1 class="text-9xl font-bold mb-4">⚠️</h1>
    <h2 class="text-9xl font-bold mb-2">500</h2>
    <h3 class="text-2xl mb-4">Internal Server Error</h3>
    <p class="text-lg text-gray-200 mb-6">
      Oops! Something went wrong on our end. We're working to fix the issue.
      Please try again later.
    </p>

    <div class="space-y-4 mb-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 max-w-md mx-auto">
        <a href="/" class="btn btn-primary">Home</a>
        <a href="/blog" class="btn btn-outline">Blog</a>
        <a href="/blog/tag/clients" class="btn btn-outline">Past Work</a>
        <a href="https://forms.timjedrek.com/contact" class="btn btn-outline"
          >Contact</a
        >
      </div>
    </div>

    <p class="text-gray-100 mb-6">
      If the problem persists, please <a
        href="https://forms.timjedrek.com/contact"
        class="text-blue-200 hover:underline">contact us</a
      >.
    </p>

    <a class="btn btn-accent mt-4" href="/">Take Me Home</a>
  </div>
</BaseLayout>
